# ============================================================
# NOMDO — MODELO DE VARIÁVEIS DE AMBIENTE
# Copie este arquivo para ".env" e preencha os valores reais.
# Nenhuma chave abaixo é obrigatória além de SECRET_KEY e
# DATABASE_URL — todo o resto tem degradação graciosa: sem a
# chave, a funcionalidade correspondente simplesmente não aparece
# ou fica desativada, o resto do sistema continua funcionando.
# ============================================================

# =========================
# FLASK
# =========================
FLASK_ENV=development
FLASK_DEBUG=1

# Gere um valor aleatório único por ambiente, nunca reaproveite este.
SECRET_KEY=troque-por-um-valor-aleatorio-longo

# =========================
# SESSÃO / COOKIES
# =========================
SESSION_COOKIE_NAME=staykey_session
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# LOCAL = False
# PRODUÇÃO = True
SESSION_COOKIE_SECURE=False

PERMANENT_SESSION_LIFETIME_DAYS=30

# =========================
# BANCO DE DADOS
# =========================

# SQLite local (dev). Em produção, use uma URL Postgres (ex.:
# postgresql://usuario:senha@host:5432/nomdo).
DATABASE_URL=sqlite:///database.db

SQLALCHEMY_TRACK_MODIFICATIONS=False

# =========================
# GOOGLE OAUTH (login social)
# =========================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =========================
# EMAIL SMTP
# =========================
EMAIL_REMETENTE=
EMAIL_SENHA=

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# =========================
# UPLOADS
# =========================
UPLOAD_FOLDER=static/uploads

MAX_CONTENT_LENGTH=5242880

# =========================
# SEGURANÇA
# =========================
WTF_CSRF_ENABLED=True

# =========================
# CLOUDFLARE R2 (armazenamento persistente de fotos de imóvel, avatar e
# documentos do hóspede). Sem preencher, o app usa disco local (bom pra
# dev — mas em produção no Render os arquivos se perdem a cada redeploy).
# Ver comentário completo em config/settings.py sobre onde pegar cada valor.
# =========================
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=

# =========================
# CRON (checagens diárias agendadas — pilha, limpeza, e-mails ao
# hóspede). Sem CRON_SECRET, o endpoint /api/cron/processar-lembretes
# fica desativado. APP_BASE_URL é a URL pública do site (sem barra no
# final), usada pra montar links nos e-mails quando o cron chama o
# endpoint — se vazia, usa o host da própria requisição.
# =========================
CRON_SECRET=
APP_BASE_URL=

# =========================
# NOTIFICAÇÕES PUSH (Web Push / VAPID)
# Sem essas chaves, o toggle "Notificações no Navegador" simplesmente
# não funciona (avisa e não quebra nada). Gere seu próprio par com:
#   pip install pywebpush && vapid --gen
# =========================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=

# =========================
# GOOGLE MAPS (guia do hóspede — "O que fazer por perto")
# Precisa de Maps JavaScript API + Places API ativadas e faturamento
# habilitado no Google Cloud Console.
# =========================
GOOGLE_MAPS_API_KEY=

# =========================
# TICKETMASTER (eventos regionais no Hub do Anfitrião)
# Tier gratuito (Discovery API): https://developer.ticketmaster.com/
# =========================
TICKETMASTER_API_KEY=

# =========================
# FOURSQUARE PLACES (nota/nº de avaliações em "O que fazer por perto")
# Plano gratuito, sem cartão: https://location.foursquare.com/developer/
# =========================
FOURSQUARE_API_KEY=

# =========================
# PAYWALL (Asaas) — assinatura mensal recorrente, pré-pronta,
# desativada até preencher a chave. Deixe PAYWALL_ATIVO em False (ou
# removido) até ter uma conta Asaas de verdade — sem isso o sistema
# continua liberado pra todo mundo. Planos por quantidade de imóveis
# (ver app/services/planos.py): até 3 imóveis, até 10, e 11+.
# =========================
PAYWALL_ATIVO=False
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=
PLANO_ATE_5_CENTS=2000
PLANO_ATE_10_CENTS=3500
PLANO_MAIS_10_CENTS=5000

# =========================
# GOOGLE MAPS — geocodificação de endereço e busca de lugares/eventos
# próximos. Se as chaves dedicadas abaixo ficarem vazias, cada uma cai
# de volta pra GOOGLE_MAPS_API_KEY acima — não precisa de chave nova
# pra já funcionar.
# =========================
GOOGLE_GEOCODING_API_KEY=
GOOGLE_PLACES_API_KEY=

# =========================
# EVENTOS — plataformas adicionais (Ticketmaster já configurado acima).
# Eventbrite/Sympla/Even3 não têm API pública de busca de eventos por
# região pra terceiros (ver comentário no topo de
# app/services/eventos_service.py) — essas chaves ficam pré-prontas
# pro dia em que isso mudar; até lá o Hub só mostra um link de busca
# manual pra essas 3 plataformas.
# =========================
EVENTBRITE_API_KEY=
SYMPLA_API_KEY=
EVEN3_API_KEY=
